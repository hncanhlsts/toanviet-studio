<w:p><w:r><w:rPr><w:b/></w:rPr><w:t xml:space="preserve">Câu 1. </w:t></w:r><w:r><w:t>Viết công thức nghiệm của phương trình bậc hai ax² + bx + c = 0 (a ≠ 0).</w:t></w:r></w:p>
<w:p><w:r><w:t>Công thức nghiệm:</w:t></w:r></w:p>
<w:p><w:pPr><w:jc w:val="center"/></w:pPr></w:p>
<w:p><w:r><w:rPr><w:b/></w:rPr><w:t xml:space="preserve">Câu 2. </w:t></w:r><w:r><w:t>(tài liệu cũ, công thức soạn bằng Equation của Word)</w:t></w:r></w:p>
<w:p><w:r><w:t xml:space="preserve">Cho hàm số </w:t></w:r><m:oMath><m:r><m:t>y=</m:t></m:r><m:sSup><m:e><m:r><m:t>x</m:t></m:r></m:e><m:sup><m:r><m:t>2</m:t></m:r></m:sup></m:sSup><m:r><m:t>−4x+3</m:t></m:r></m:oMath><w:r><w:t xml:space="preserve"> và biểu thức </w:t></w:r><m:oMath><m:r><m:t>A=</m:t></m:r><m:f><m:num><m:r><m:t>x+1</m:t></m:r></m:num><m:den><m:r><m:t>2</m:t></m:r></m:den></m:f><m:r><m:t>+</m:t></m:r><m:rad><m:radPr><m:degHide m:val="1"/></m:radPr><m:deg/><m:e><m:r><m:t>x+3</m:t></m:r></m:e></m:rad></m:oMath><w:r><w:t>.</w:t></w:r></w:p>
<w:p><w:r><w:t xml:space="preserve">a) Tính </w:t></w:r><m:oMath><m:r><m:t>y</m:t></m:r><m:d><m:e><m:r><m:t>2</m:t></m:r></m:e></m:d></m:oMath><w:r><w:t xml:space="preserve"> và </w:t></w:r><m:oMath><m:r><m:t>A</m:t></m:r><m:d><m:e><m:r><m:t>1</m:t></m:r></m:e></m:d></m:oMath><w:r><w:t>.</w:t></w:r></w:p>
<w:p><w:r><w:t xml:space="preserve">b) Giải bất phương trình </w:t></w:r><m:oMath><m:sSup><m:e><m:r><m:t>x</m:t></m:r></m:e><m:sup><m:r><m:t>2</m:t></m:r></m:sup></m:sSup><m:r><m:t>−4x+3≤0</m:t></m:r></m:oMath><w:r><w:t>.</w:t></w:r></w:p>
